#!name=服务状态
#!desc=在 Surge 策略页面板中检测当前节点对 Google、GitHub、YouTube、ChatGPT、Claude、Gemini、Netflix、Disney+、Prime Video 的连通性，并显示出口 IP。点面板刷新重新检测。Netflix 一行按片源状态区分：可用 / 仅自制剧 / 不可用，其余按 HTTP 状态判断，不是完整的地区解锁检测。
#!author=Muse

[Panel]
服务状态 = title="服务状态",content="点刷新开始检测",style=info,script-name=service-status,update-interval=1

[Script]
service-status = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/opob07/singbox-anltls/main/service-status.js
