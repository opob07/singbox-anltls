#!name=拼多多去广告（Surge）
#!desc=改写自 atopsecret/SurgeScripts Egern 原生版 eg-native-20261105-r1；域名拦截 + QUIC 阻断 + 开屏空响应 + 页面净化。页面净化脚本已按 Surge API 重写（pdd-ad-block.surge.js），与本模块同处托管。
#!author=skernelx · FFDNS · RuCu6 · ZenmoFeiShi（原 Egern 版）
#!homepage=https://github.com/atopsecret/SurgeScripts/tree/main/pinduoduo

[Rule]
# 域名拦截（Egern domain → Surge DOMAIN-SUFFIX，含子域名）
DOMAIN-SUFFIX,promotion-2.pddpic.com,REJECT
DOMAIN-SUFFIX,video-snapshot01.pddpic.com,REJECT
DOMAIN-SUFFIX,titan.pinduoduo.com,REJECT
DOMAIN-SUFFIX,xg.pinduoduo.com,REJECT
DOMAIN-SUFFIX,apm.pinduoduo.com,REJECT
DOMAIN-SUFFIX,apm-a.pinduoduo.com,REJECT
DOMAIN-SUFFIX,th.pinduoduo.com,REJECT
DOMAIN-SUFFIX,th-a.pinduoduo.com,REJECT
DOMAIN-SUFFIX,th-b.pinduoduo.com,REJECT
DOMAIN-SUFFIX,ta.pinduoduo.com,REJECT
DOMAIN-SUFFIX,ta-a.pinduoduo.com,REJECT
DOMAIN-SUFFIX,meta.pinduoduo.com,REJECT
# api.pinduoduo.com 的 QUIC（UDP/443）阻断，迫使走 TCP 以便 MITM/脚本生效；REJECT-NO-DROP 让 App 立即回落 TCP 而不是超时等待
AND,((DOMAIN-SUFFIX,api.pinduoduo.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP
# 裸 IP 直连 + 拼多多 UA → 拦截
AND,((URL-REGEX,^http://(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)/d[0-9]?(?:\?|$)),(USER-AGENT,*com.xunmeng.pinduoduo*)),REJECT
AND,((URL-REGEX,^http://\[[0-9a-fA-F:]+\]/d[0-9]?\?),(USER-AGENT,*com.xunmeng.pinduoduo*)),REJECT
# /v3/d?type=addrs + 拼多多 UA → 拦截
AND,((URL-REGEX,^http://[^/]+/v3/d\?(?:[^#]*&)?type=addrs(?:&|$)),(USER-AGENT,*pinduoduo*)),REJECT

[Script]
# 页面原生净化：首页/个人/订单/搜索接口的 JSON 去广告字段。脚本已按 Surge API 重写，原 Egern 版（export default + ctx）不能直接在 Surge 跑。
拼多多页面原生净化 = type=http-response,pattern=^https?://[^/]+/(api/(alexa/homepage/hub|philo/personal/hub|oak/integration/render|aristotle/order_list_v4)(?:\?|$)|order/|search(?:\?|$)),requires-body=true,max-size=131072,script-path=https://raw.githubusercontent.com/opob07/singbox-anltls/main/pdd-ad-block.surge.js,update-interval=3600,timeout=30

[Map Local]
# 开屏接口：空响应
^https?://api\.(pinduoduo|yangkeduo)\.com(?::[0-9]+)?/api/cappuccino/splash(?:[/?]|$) data-type=text data="" status-code=200
# 视频浮层 HTML：空页面
^https?://m\.pinduoduo\.net(?::[0-9]+)?/vlayer_tab_popup\.html(?:\?|$) data-type=text data="<!DOCTYPE html><html><body></body></html>" header="Content-Type: text/html; charset=utf-8" status-code=200
# 其余接口：空 JSON
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/aristotle/unrated_order_for_unreceived_tab(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/aristotle/query_order_list_tabs_element(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/aquarius/hungary/global/homepage(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/caterham/v3/query/order_express_group(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/search_hotquery(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/zaire_biz/chat/resource/get_list_data(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/caterham/v3/query/new_chat_group(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/alexa/goods/back_up(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/caterham/v3/query/personal(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/brand-olay/goods_detail/bybt_guide(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/engels/reviews/require/append(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/caterham/v3/query/my_order_group(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/caterham/v3/query/likes(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/phantom/gbdbpdv/extra(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/manufacturer/cross/shortcut/list(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/dunkirk/liveactivity/push/create/url/report(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/growth/nagato/app/index/gather(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/engels/wait/receive/review(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200
^https?://api\.pinduoduo\.com(?::[0-9]+)?/api/buffon/nasus/recommend(?:\?|$) data-type=text data="{}" header="Content-Type: application/json" status-code=200

[MITM]
hostname = %APPEND% api.pinduoduo.com, api.yangkeduo.com, m.pinduoduo.net
